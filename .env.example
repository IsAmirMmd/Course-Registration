# اطلاع‌رسانیِ ورود به کانال تلگرام — اختیاری
#
# توکن و شناسه‌ی کانال به‌صورت پیش‌فرض داخلِ `src/lib/notify.ts` هستند، پس اپ
# بدونِ این فایل هم پیام می‌فرستد. این فایل فقط برای **عوض‌کردنِ** آن‌ها بدونِ
# دست‌زدن به کد است (مثلاً یک باتِ دیگر برای محیطِ آزمایش).
#
# این فایل را به `.env.local` کپی کنید — `.env.local` در .gitignore است.
#
# ⚠️ یادآوری: هر متغیرِ VITE_* داخل جاوااسکریپتِ بیلد می‌نشیند و برای هر
# بازدیدکننده خواندنی است. این فایل توکن را از دیدِ کاربر پنهان نمی‌کند، فقط
# از مخزنِ گیت بیرون نگهش می‌دارد.

# توکنی که BotFather می‌دهد
VITE_TG_BOT_TOKEN=

# شناسه‌ی عددیِ کانال، با علامتِ منفی — مثل -1002247521670
# (بات باید در کانال ادمین باشد تا بتواند پیام بفرستد.)
VITE_TG_CHAT_ID=
