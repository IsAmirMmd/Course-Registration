# اطلاع‌رسانیِ ورود به کانال تلگرام
#
# این فایل را به `.env.local` کپی کنید و مقدارهای خودتان را بگذارید.
# `.env.local` در .gitignore است و به مخزن نمی‌رود.
#
# ⚠️ هشدارِ مهم: این اپ بک‌اند ندارد. هر متغیری که با VITE_ شروع شود داخل
# جاوااسکریپتِ بیلد قرار می‌گیرد، پس هر کسی که صفحه را باز کند می‌تواند توکن را
# بخواند و با باتِ شما پیام بفرستد. نگه‌داشتن توکن در .env.local فقط جلوی
# لو‌رفتنش در گیت را می‌گیرد، نه در مرورگر.
#
# اگر این ریسک برایتان پذیرفتنی نیست، بخشِ «اطلاع‌رسانی ورود» در README را
# ببینید: با یک اندپوینتِ کوچکِ سمتِ سرور توکن هرگز به مرورگر نمی‌رسد.
#
# اگر این دو متغیر خالی بمانند، اپ کاملاً کار می‌کند و فقط پیامی فرستاده نمی‌شود.

# توکنی که BotFather می‌دهد
VITE_TG_BOT_TOKEN=

# شناسه‌ی عددیِ کانال، با علامتِ منفی — مثل -1002247521670
# (بات باید در کانال ادمین باشد تا بتواند پیام بفرستد.)
VITE_TG_CHAT_ID=
